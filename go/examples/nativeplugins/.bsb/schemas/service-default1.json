{
  "pluginId": "service-default1",
  "pluginName": "service-default1",
  "events": {
    "data.processed": {
      "type": "fire-and-forget",
      "category": "emitEvents",
      "description": "Emitted when data processing is complete",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "itemId": {
              "kind": "string"
            },
            "result": {
              "kind": "unknown"
            },
            "processingTime": {
              "kind": "number"
            }
          },
          "required": [
            "itemId",
            "result",
            "processingTime"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Data processing result"
          }
        }
      },
      "outputSchema": null
    },
    "data.received": {
      "type": "fire-and-forget",
      "category": "onEvents",
      "description": "Handle incoming data for processing",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "itemId": {
              "kind": "string"
            },
            "data": {
              "kind": "unknown"
            },
            "source": {
              "kind": "string"
            }
          },
          "required": [
            "itemId",
            "data",
            "source"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Received data parameters"
          }
        }
      },
      "outputSchema": null
    },
    "calculation.request": {
      "type": "returnable",
      "category": "emitReturnableEvents",
      "description": "Request calculation from external service",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "operation": {
              "kind": "enum",
              "values": [
                "add",
                "subtract",
                "multiply",
                "divide"
              ]
            },
            "operands": {
              "kind": "array",
              "items": {
                "kind": "number"
              },
              "minItems": 2
            }
          },
          "required": [
            "operation",
            "operands"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Calculation request parameters"
          }
        }
      },
      "outputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "number"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Calculation result"
          }
        }
      }
    },
    "text.transform": {
      "type": "returnable",
      "category": "onReturnableEvents",
      "description": "Transform text according to specified operation",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "text": {
              "kind": "string"
            },
            "transformation": {
              "kind": "enum",
              "values": [
                "uppercase",
                "lowercase",
                "reverse",
                "capitalize"
              ]
            }
          },
          "required": [
            "text",
            "transformation"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Text transformation parameters"
          }
        }
      },
      "outputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "string"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Transformed text"
          }
        }
      }
    },
    "calculate": {
      "type": "returnable",
      "category": "onReturnableEvents",
      "description": "Calculate with two numbers",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "a": {
              "kind": "number"
            },
            "b": {
              "kind": "number"
            }
          },
          "required": [
            "a",
            "b"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Calculation parameters"
          }
        }
      },
      "outputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "number"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Calculation result"
          }
        }
      }
    },
    "service.status": {
      "type": "broadcast",
      "category": "emitBroadcast",
      "description": "Broadcast service status updates",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "status": {
              "kind": "enum",
              "values": [
                "starting",
                "ready",
                "busy",
                "stopping"
              ]
            },
            "timestamp": {
              "kind": "string",
              "format": "date-time"
            },
            "details": {
              "kind": "optional",
              "inner": {
                "kind": "string"
              }
            }
          },
          "required": [
            "status",
            "timestamp"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Service status parameters"
          }
        }
      },
      "outputSchema": null
    },
    "config.updated": {
      "type": "broadcast",
      "category": "onBroadcast",
      "description": "Listen for configuration update broadcasts",
      "inputSchema": {
        "anyvaliVersion": "1.0",
        "schemaVersion": "1.1",
        "root": {
          "kind": "object",
          "properties": {
            "section": {
              "kind": "string"
            },
            "changes": {
              "kind": "record",
              "valueSchema": {
                "kind": "unknown"
              }
            },
            "version": {
              "kind": "string"
            }
          },
          "required": [
            "section",
            "changes",
            "version"
          ],
          "unknownKeys": "strip"
        },
        "definitions": {},
        "extensions": {
          "bsb": {
            "description": "Config update parameters"
          }
        }
      },
      "outputSchema": null
    }
  },
  "version": "1.0.0",
  "language": "go"
}
