    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading><AssemblyName>config-vault-google</AssemblyName>
    <OutputPath>../../../dotnet/BetterServiceBase/bin/$(Configuration)/net10.0/plugins/config-vault-google/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/BSB/BSB.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../config-vault/config-vault.csproj" />
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />
  </ItemGroup>
</Project>
